# Copie este archivo como .env y cambie los valores:  cp .env.example .env
# El .env real NO se sube al repositorio (esta en .gitignore).

# Secreto para firmar los JWT. Use una cadena larga y aleatoria, por ejemplo:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=cambie-esta-clave

# Opcionales (valores por defecto del backend)
MINUTOS_SIN_RESPUESTA=5
MINUTOS_EN_COLA=10
INTERVALO_ESCALACION_MS=30000