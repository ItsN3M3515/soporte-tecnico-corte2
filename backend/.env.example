# Copie este archivo como .env o exporte las variables antes de `npm start`
PORT=3000
DB_PATH=./data/soporte.db
JWT_SECRET=cambie-este-secreto
# Minutos que tiene un técnico para aceptar antes de reasignar
MINUTOS_SIN_RESPUESTA=5
# Minutos en cola sin técnico antes de escalar al coordinador
MINUTOS_EN_COLA=10
# Cada cuánto revisa el programador de escalación (ms)
INTERVALO_ESCALACION_MS=30000
